# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables
# (or pull them locally with `vercel env pull .env.local`).

# Google Maps JavaScript API key (public; restrict it by HTTP referrer in Google Cloud Console).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase project (Settings → API). Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser login (Supabase Auth: Google + e-mail code/link), required to add a new bar.
# Same project as above: Settings → API → Project URL and the "anon" public key.
# Safe to expose: RLS (supabase/migrations/004_auth_rate_limits_and_moderation.sql) blocks every
# direct table read/write with this key; data only goes through our /api routes (service role).
# Without them the login card is hidden and creating a bar answers 401 whenever the backend is set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google OAuth *web* client id (Google Cloud → Credentials), same client configured in
# Supabase Auth → Providers → Google. When set, "Continuar com Google" uses Google Identity
# Services + signInWithIdToken, so Google's consent shows this site's origin instead of
# <project>.supabase.co. Add the site origins under "Authorized JavaScript origins" first.
# Unset: the login falls back to the signInWithOAuth redirect.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: contact e-mail shown on /privacidade for data requests (server-only; read at build).
# Unset: the page points to the support e-mail shown in Google's sign-in window.
# CONTACT_EMAIL=

# Master kill switch: in production every write (add bar, edit prices, report prices) answers 403
# unless this is "true". Set it back to false to stop all writes instantly. Always allowed in `next dev`.
# Before enabling, apply migrations 003 to 005 (auth, rate limits, RLS, price freshness, favorites).
USER_EDITS_ENABLED=false

# Optional: moderators for /admin (review queue of reported bars), comma-separated e-mails.
# Server-only. Only signed-in users with a confirmed e-mail in this list get access; unset = nobody.
# ADMIN_EMAILS=

# "Ler cardápio por foto" (menu photo -> prices): Vercel AI Gateway key, server-only.
# Unset: the button answers "ainda não está disponível" (503) and nothing is sent anywhere.
# Before changing the model, check the current list: curl https://ai-gateway.vercel.sh/v1/models
# AI_GATEWAY_API_KEY=
# Optional: vision model with structured output (default google/gemini-2.5-flash-lite).
# MENU_PHOTO_MODEL=google/gemini-2.5-flash-lite
# Optional: site-wide cap on menu readings per day (paid calls; default 200).
# MENU_PHOTO_DAILY_LIMIT=200

# Optional: salt for the SHA-256 hashes of client IPs / user ids used by write rate limits
# (raw IPs are never stored). Defaults to SUPABASE_SERVICE_ROLE_KEY. Changing it resets the limits.
# RATE_LIMIT_SALT=

# Optional: absolute site URL for share links/OG images. On Vercel this falls back to the
# production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://brejamap.vercel.app

# Optional: extra dev origins (e.g. ngrok) allowed by `next dev`, comma-separated.
# NEXT_ALLOWED_DEV_ORIGINS=https://foo.ngrok-free.dev
