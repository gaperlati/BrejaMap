# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables
# (or pull them locally with `vercel env pull .env.local`).

# Google Maps JavaScript API key (public; restrict it by HTTP referrer in Google Cloud Console).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase project (Settings → API). Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser login (Supabase Auth: Google + e-mail code/link), required to add a new bar.
# Same project as above: Settings → API → Project URL and the "anon" public key.
# Safe to expose: RLS (supabase/migrations/004_auth_rate_limits_and_moderation.sql) blocks every
# direct table read/write with this key; data only goes through our /api routes (service role).
# Without them the login card is hidden and creating a bar answers 401 whenever the backend is set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Master kill switch: in production every write (add bar, edit prices, report prices) answers 403
# unless this is "true". Set it back to false to stop all writes instantly. Always allowed in `next dev`.
# Before enabling, apply migrations 003 and 004 (auth, rate limits, RLS).
USER_EDITS_ENABLED=false

# Optional: salt for the SHA-256 hashes of client IPs / user ids used by write rate limits
# (raw IPs are never stored). Defaults to SUPABASE_SERVICE_ROLE_KEY. Changing it resets the limits.
# RATE_LIMIT_SALT=

# Optional: absolute site URL for share links/OG images. On Vercel this falls back to the
# production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://brejamap.vercel.app

# Optional: extra dev origins (e.g. ngrok) allowed by `next dev`, comma-separated.
# NEXT_ALLOWED_DEV_ORIGINS=https://foo.ngrok-free.dev
