# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables
# (or pull them locally with `vercel env pull .env.local`).

# Google Maps JavaScript API key (public; restrict it by HTTP referrer in Google Cloud Console).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase project (Settings → API). Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public writes (add bar / edit prices) are blocked in production unless this is "true".
# Keep it off until auth or anti-abuse is in place. Writes are always allowed in `next dev`.
USER_EDITS_ENABLED=false

# Optional: absolute site URL for share links/OG images. On Vercel this falls back to the
# production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://brejamap.vercel.app

# Optional: extra dev origins (e.g. ngrok) allowed by `next dev`, comma-separated.
# NEXT_ALLOWED_DEV_ORIGINS=https://foo.ngrok-free.dev
